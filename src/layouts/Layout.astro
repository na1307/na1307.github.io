---
import '../styles/global.css'
import {getRelativeLocaleUrl} from 'astro:i18n';

const {locale} = Astro.props
const year = new Date().getFullYear()
const trimmedPath = Astro.originPathname.replace('/ko', '').replace('/en', '')
---

<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>Bluehill / Jonghyo Lee</title>
    <script is:inline>
        // 깜빡임 방지를 위해 HTML 로드 전에 테마 적용
        (function () {
            const theme = localStorage.getItem('theme') ||
                (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
</head>
<body>
<div id="bh-root">
    <div id="top">
        <button id="menu-toggle" aria-label="Toggle menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <div id="top-bar">
            <a href={getRelativeLocaleUrl(locale, '/')}>Home</a>
            <a href={getRelativeLocaleUrl(locale, '/about')}>About</a>
            <a href={getRelativeLocaleUrl(locale, '/projects')}>Projects</a>
            <a href={getRelativeLocaleUrl(locale, '/time')}>Time</a>
        </div>
        <div id="controls">
            <button id="theme-toggle" aria-label="Toggle theme">
                <svg id="theme-icon-light" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                     viewBox="0 0 16 16">
                    <path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z"/>
                </svg>
                <svg id="theme-icon-dark" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 16 16"
                     style="display: none;">
                    <path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"/>
                </svg>
            </button>
            <span id="language-selector">{locale === 'en' ? <span style="font-weight: bold">English</span> :
                    <a href={`/en${trimmedPath}`}>English</a>} &VerticalBar; {locale === 'ko' ?
                    <span style="font-weight: bold">한국어</span> : <a href={`/ko${trimmedPath}`}>한국어</a>}</span>
        </div>
    </div>
    <slot/>
    <div id="bottom">
        <p>Copyright &copy; {year} Bluehill</p>
    </div>
</div>
</body>
</html>

<style>
    html, body {
        height: 100vh;
    }

    body {
        display: flex;
        justify-content: center;
        margin: 0;
    }

    div#bh-root {
        width: 100%;
        min-width: 350px;
        max-width: 800px;
        padding: 0 15px;
    }

    div#top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-top: 10px;
        margin-bottom: 10px;
        border-bottom: 1px solid;
        border-color: var(--bs-border-color);
        position: relative;
    }

    #controls {
        display: flex;
        align-items: flex-end;
        gap: 15px;
    }

    #menu-toggle {
        display: none;
        flex-direction: column;
        gap: 4px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 5px;
        z-index: 1001;
        position: relative;
        width: 30px;
        height: 30px;
        justify-content: center;
        align-items: center;
    }

    #menu-toggle span {
        width: 25px;
        height: 3px;
        background-color: var(--bs-body-color);
        transition: all 0.3s ease;
        display: block;
        position: absolute;
    }

    #menu-toggle span:nth-child(1) {
        transform: translateY(-5px);
    }

    #menu-toggle span:nth-child(2) {
        transform: translateY(0);
    }

    #menu-toggle span:nth-child(3) {
        transform: translateY(5px);
    }

    #menu-toggle.active span:nth-child(1) {
        transform: rotate(45deg) translateY(0);
    }

    #menu-toggle.active span:nth-child(2) {
        opacity: 0;
    }

    #menu-toggle.active span:nth-child(3) {
        transform: rotate(-45deg) translateY(0);
    }

    #theme-toggle {
        background: none;
        border: none;
        cursor: pointer;
        padding: 5px;
        display: flex;
        align-items: center;
        color: var(--bs-body-color);
        transition: opacity 0.2s;
    }

    #theme-toggle:hover {
        opacity: 0.7;
    }

    #theme-toggle svg {
        fill: currentColor;
    }

    div#top-bar {
        font-size: 20pt;
        column-gap: 15px;
    }

    span#language-selector {
        padding-bottom: 5px;
    }

    div#bottom {
        display: flex;
        padding-top: 5px;
        border-top: 1px solid;
        border-color: var(--bs-border-color);
    }

    @media (max-width: 600px) {
        #menu-toggle {
            display: flex;
        }

        div#top {
            flex-wrap: wrap;
        }

        div#top-bar {
            display: none;
            flex-direction: column;
            width: 100%;
            order: 3;
            padding-bottom: 10px;
        }

        div#top-bar.active {
            display: flex;
        }

        #controls {
            width: 100%;
            order: 4;
            justify-content: center;
            display: none;
            padding-bottom: 10px;
        }

        #controls.active {
            display: flex;
        }

        span#language-selector {
            padding-bottom: 0;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuToggle = document.getElementById('menu-toggle');
        const topBar = document.getElementById('top-bar');
        const controls = document.getElementById('controls');
        const themeToggle = document.getElementById('theme-toggle');
        const themeIconLight = document.getElementById('theme-icon-light');
        const themeIconDark = document.getElementById('theme-icon-dark');

        // 메뉴 토글
        menuToggle?.addEventListener('click', () => {
            menuToggle.classList.toggle('active');
            topBar?.classList.toggle('active');
            controls?.classList.toggle('active');
        });

        // 다크 모드 토글
        function updateThemeIcon(theme: string) {
            if (theme === 'dark') {
                themeIconLight!.style.display = 'none';
                themeIconDark!.style.display = 'block';
            } else {
                themeIconLight!.style.display = 'block';
                themeIconDark!.style.display = 'none';
            }
        }

        function setTheme(theme: string) {
            document.documentElement.setAttribute('data-bs-theme', theme);
            localStorage.setItem('theme', theme);
            updateThemeIcon(theme);
        }

        // 초기 아이콘 설정
        const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
        updateThemeIcon(currentTheme);

        themeToggle?.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-bs-theme');
            const newTheme = current === 'dark' ? 'light' : 'dark';
            setTheme(newTheme);
        });
    });
</script>
